# === Production environment template ===
# Copy to production.env and fill in real values (production.env is gitignored).

PORT=5000

# MySQL connection (your production database)
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Deepgram API key (https://console.deepgram.com/)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Public base URL of the API as reached by the browser (baked into the frontend
# bundle at build time), e.g. https://api.your-domain.com
VITE_API_URL=http://localhost:5000
