# === Development environment template ===
# Copy to development.env and fill in real values (development.env is gitignored).

PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=subtitles_db

# Deepgram API key (https://console.deepgram.com/)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Public base URL of the API as reached by the browser.
VITE_API_URL=http://localhost:5000
